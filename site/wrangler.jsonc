// Cloudflare Workers static assets (repo README, decision 5). Nothing here deploys by itself: build with the real
// domain (SITE_URL=https://… npm run build), then run `npx wrangler deploy` from site/.
// - `_headers` in dist/ sets caching and security headers.
// - Unknown paths get dist/404.html with a 404 status.
// - /work/glassbox is served from work/glassbox.html (the default html_handling), matching build.format: 'file'.
{
  "name": "yash-chauhan-portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
