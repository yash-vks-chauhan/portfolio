---
import Base from '../layouts/Base.astro';
import Footer from '../components/shell/Footer.astro';
import Hero from '../components/home/Hero.astro';
import Widgets from '../components/home/Widgets.astro';
import AskSection from '../components/home/AskSection.astro';
import { numberSources, footnotes } from '../lib/citations';

// Citation order on the home page: the widgets, then the sources the Experience sheets cite.
const n = numberSources(['gridee-downloads', 'glassbox-eval-v4', 'glassbox-ci', 'iitm-internship', 'hindalco-report', 'srm-record']);
---

<Base
  title="Yash Chauhan · AI/ML Engineer"
  description="Yash Chauhan builds AI systems you can audit: cited answers, refusals when evidence is missing, and a log of every decision. Final-year B.Tech CSE (AI/ML) at SRM, co-founder of Gridee."
  section="home"
  isHome
>
  <Hero />
  <Widgets n={n} />
  <AskSection />
  <section id="work" class="h-[600px]"></section>
  <section id="about" class="h-[600px]"></section>
  <section id="contact" class="h-[600px]"></section>
  <Footer slot="footer" notes={footnotes(n)} sourcesHref="#footnotes" gap={120} />
</Base>
