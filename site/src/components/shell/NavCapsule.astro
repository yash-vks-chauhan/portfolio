---
// The floating nav capsule (desktop and tablet): thin glass, 56 px tall, sticky 16 px from the top, 44 px targets.
// GlassSurface adds liquid refraction on Chromium (NavGlass); everywhere else the CSS frost is the look.
import ThemeSwitch from './ThemeSwitch';
import NavGlass from '../bits/NavGlass';
import { navLinks, type Section } from '../../lib/nav';
import { site } from '../../content/site';

interface Props {
  current: Section;
  isHome?: boolean;
}

const { current, isHome = false } = Astro.props;
const links = navLinks(isHome);
---

<div class="pointer-events-none fixed inset-x-0 top-0 z-50 hidden justify-center px-4 md:flex">
  <nav
    id="nav-capsule"
    aria-label="Main"
    class="glass-thin pointer-events-auto mt-4 flex flex-wrap items-center justify-center gap-1 rounded-[28px] p-1.5"
  >
    <a href={isHome ? '#top' : '/'} class="flex h-11 items-center gap-2.5 pr-3 pl-1 text-[15px] font-semibold tracking-[-0.012em]">
      <span class="yc-mark" aria-hidden="true">{site.initials}</span>{site.name}
    </a>
    <div class="flex gap-0.5">
      {
        links.map((l) => {
          const on = l.key === current;
          return (
            <a
              href={l.href}
              aria-current={on ? 'page' : undefined}
              class:list={[
                'nl flex h-11 items-center rounded-full px-4 text-[14px] tracking-[-0.016em]',
                on ? 'bg-fill2 font-medium text-label' : 'text-label2',
              ]}
            >
              {l.label}
            </a>
          );
        })
      }
    </div>
    <ThemeSwitch client:idle />
    <a
      href={site.links.resume}
      class="pill flex h-11 items-center rounded-full bg-accent px-[18px] text-[14px] font-semibold tracking-[-0.016em] text-on-accent"
    >
      Résumé
    </a>
  </nav>
  <NavGlass client:idle target="nav-capsule" />
</div>
